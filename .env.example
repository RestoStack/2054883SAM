SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
# Server-only — never expose in client bundles or public repos
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Ship mode: invite (default) | demo | public
# invite = customer beta (no open signup, no demo credential UI)
# demo   = sales sample restaurant + known demo logins
# public = reserved; open signup still requires VITE_ALLOW_PUBLIC_SIGNUP=true
VITE_SHIP_MODE="invite"
# VITE_ALLOW_PUBLIC_SIGNUP="false"
# VITE_ENABLE_DEMO_ACCESS="false"
# VITE_INVITE_CODE="optional-shared-invite-code"

# Platform super-admins are seeded in the database allowlist
# (table: v2_platform_admin_allowlist). Add an email there, then
# that user becomes a platform admin on next login via
# v2_claim_platform_admin().
