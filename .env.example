# Client (browser) — anon key only
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Legacy aliases still read by some tooling:
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
# Server-only — never expose in client bundles or public repos
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Ship mode: launch (default) | demo | invite | public
VITE_SHIP_MODE="launch"

# Optional Sentry (client)
# VITE_SENTRY_DSN=""
